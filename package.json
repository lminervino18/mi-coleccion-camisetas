{
  "name": "mi-coleccion-camisetas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @camisetas/db generate",
    "db:migrate": "pnpm --filter @camisetas/db migrate",
    "db:seed": "pnpm --filter @camisetas/db seed",
    "test:e2e": "pnpm --filter web test:e2e"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": "^8.5.18",
      "sharp@<0.35.0": "^0.35.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "@node-rs/argon2",
      "sharp",
      "unrs-resolver"
    ]
  }
}
