{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { 
        "distDir": "build",
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/static/$1"
    },
    {
      "src": "^/favicon.ico$",
      "dest": "/favicon.ico"
    },
    {
      "src": "^/manifest.json$",
      "dest": "/manifest.json"
    },
    {
      "src": "^/asset-manifest.json$",
      "dest": "/asset-manifest.json"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://ec2-56-124-125-28.sa-east-1.compute.amazonaws.com/api/$1"
    },
    {
      "src": "/auth/(.*)",
      "dest": "https://ec2-56-124-125-28.sa-east-1.compute.amazonaws.com/auth/$1"
    },
    {
      "src": "/(.*)\\.(?:js|css|map|json|ico|png|jpg|jpeg|svg|gif)$",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}