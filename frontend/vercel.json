{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "http://ec2-56-124-125-28.sa-east-1.compute.amazonaws.com/api/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/(.*)",
      "headers": {
        "Cache-Control": "s-maxage=1, stale-while-revalidate"
      },
      "dest": "/index.html"
    }
  ],
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    }
  ]
}