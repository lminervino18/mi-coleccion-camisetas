{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://ec2-54-233-79-32.sa-east-1.compute.amazonaws.com/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "http://ec2-54-233-79-32.sa-east-1.compute.amazonaws.com/auth/$1"
    },
    {
      "source": "/shared/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
