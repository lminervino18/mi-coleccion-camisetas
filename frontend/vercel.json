{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://ec2-56-124-125-28.sa-east-1.compute.amazonaws.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "routes": [
    {
      "src": "/[^.]+",
      "dest": "/",
      "status": 200
    }
  ]
}