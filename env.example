# Copiá este archivo a apps/web/.env.local y completá los valores.
# Las variables marcadas como opcionales activan servicios externos: sin ellas la aplicación
# funciona igual usando alternativas locales.

# --- Obligatorias ---

# Cadena de conexión a PostgreSQL.
# Local (docker compose up -d): postgresql://postgres:postgres@127.0.0.1:5433/camisetas
# Neon: postgresql://usuario:clave@ep-xxx.neon.tech/camisetas?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/camisetas

# URL pública de la aplicación. Se usa para los enlaces compartidos, los correos y las
# previsualizaciones sociales, así que tiene que ser la URL real en producción.
APP_URL=http://localhost:3000

# --- Opcionales: almacenamiento de imágenes (Cloudflare R2) ---
# Sin estas cuatro variables las imágenes se guardan en apps/web/.uploads y se sirven desde
# la propia aplicación. Con ellas se suben directo al bucket.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=camisetas
# URL pública del bucket. Si falta, las imágenes se sirven por /api/images.
# R2_PUBLIC_URL=https://imagenes.tudominio.com

# --- Opcionales: correo transaccional (Brevo) ---
# Sin BREVO_API_KEY los correos de recuperación se escriben en el log del servidor en vez de
# enviarse, lo que permite probar el flujo completo sin credenciales.
# BREVO_API_KEY=
MAIL_FROM=no-reply@micoleccioncamisetas.com

# --- Solo para tests de integración ---
# Base separada: se trunca en cada prueba, nunca apuntes a datos reales.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/camisetas_test
